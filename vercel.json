{
  "rewrites": [
    {
      "source": "/chat/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/store/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/profile/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/medicine/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/application/frontend/$1"
    }
  ]
}
