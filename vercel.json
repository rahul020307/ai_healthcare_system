{
  "outputDirectory": "application/frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/api/:path*"
    },
    {
      "source": "/chat/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/chat/:path*"
    },
    {
      "source": "/store/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/store/:path*"
    },
    {
      "source": "/profile/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/profile/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/auth/:path*"
    },
    {
      "source": "/medicine/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/medicine/:path*"
    },
    {
      "source": "/maps/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/maps/:path*"
    },
    {
      "source": "/home/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/home/:path*"
    },
    {
      "source": "/db/:path*",
      "destination": "https://curaassist-carehub-backend-2.fastapicloud.dev/db/:path*"
    }
  ]
}
