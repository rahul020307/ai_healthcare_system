{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/store/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/profile/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/medicine/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/application/frontend/$1"
    }
  ]
}
